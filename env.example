# Copy this file to .env and fill in the blanks.
# Never commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
USE_WEBHOOK=false

# PostgreSQL
# Use the same database name as docker-compose (chatbot, lowercase).
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatbot
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# This Node app
PORT=3000
BACKEND_URL=http://localhost:3000

# Whisper service
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_URL=http://localhost:9000

# OpenAI-compatible chat completions API.
# The app reads LLM_BASE_URL (include the /v1 prefix).
# Host process: http://127.0.0.1:1234/v1
# App container: http://host.docker.internal:1234/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=openai/gpt-oss-20b

# YouTube Data API (required for /recommendations search hits)
YOUTUBE_API_KEY=

# Proactive timing (optional; defaults live in src/services/proactive/constants.js)
PROACTIVE_PAUSE_SECONDS=10
PROACTIVE_COOLDOWN_SECONDS=30
PROACTIVE_DEFINITION_THRESHOLD=0.5
PROACTIVE_COMPLEX_THRESHOLD=0.5
PROACTIVE_SECTION_COOLDOWN_SECONDS=10
PROACTIVE_RESUME_BREAK_SECONDS=10
PROACTIVE_SEEK_JUMP_SECONDS=20
PROACTIVE_KEY_MOMENT_MIN_DELAY_SECONDS=15
PROACTIVE_KEY_MOMENT_MAX_DELAY_SECONDS=20
PROACTIVE_OPEN_UNANSWERED_SECONDS=12
PROACTIVE_EVENT_COALESCE_MS=450
PROACTIVE_EVENT_RETRY_MS=120
PROACTIVE_REPLY_WINDOW_SECONDS=240
PROACTIVE_SHORT_REPLY_MAX_CHARS=40
