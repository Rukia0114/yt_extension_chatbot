{
  "manifest_version": 3,
  "name": "Video with Telegram Bot",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://m.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://youtu.be/*"
      ],
      "js": [
        "shared/youtube.js",
        "content/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {},
  "side_panel": {
    "default_path": "chat-window/chat-window.html"
  }
}